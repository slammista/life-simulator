# Life Simulator 2D — Environment Variables
# Copy this file to .env and fill in your credentials

# Supabase — Cloud Save (optional)
# Get these from: https://supabase.com → Project Settings → API
# Leave empty to disable cloud save (local save via localStorage will still work)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
